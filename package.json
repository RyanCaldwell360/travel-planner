{
  "name": "travel-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "cf:check": "npm run build && wrangler deploy --dry-run --outdir /tmp/travel-planner-worker-build",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:export": "wrangler d1 export DB --remote --output .data/cloudflare-backup.sql"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
