# This file is documentation. The server reads process environment variables;
# it does not load .env automatically. Supply values via your service manager.
PORT=3000
HOST=0.0.0.0
DATA_DIR=.data
# Set true behind production HTTPS; local HTTP development requires false.
COOKIE_SECURE=false
# Optional discovery providers. Never commit real credentials.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
